{
  "name": "aeris",
  "private": true,
  "type": "module",
  "description": "Aeris discovery pilot. See docs/00-START-HERE.md.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:safety": "node --experimental-strip-types --no-warnings --test src/safety/controller.test.ts src/content/content.test.ts",
    "test:db": "bash supabase/tests/run_local.sh",
