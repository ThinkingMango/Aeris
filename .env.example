# ---------------------------------------------------------------------------
# Aeris environment.
#
# Copy to .env.local for development. On Vercel these are set per environment
# under Project → Settings → Environment Variables.
#
# Never put a secret in a NEXT_PUBLIC_* variable. Everything with that prefix
# is compiled into the JavaScript the browser downloads.
# ---------------------------------------------------------------------------

# Deployment identity. Server-authoritative. In production this switches on
# several refusals: no database, no Supabase, or an unpooled connection string
# all become startup failures rather than silent degradation.
# One of: development | staging | production
APP_ENV=development

# --- Database (Supabase Postgres) ------------------------------------------
#
# Leave BLANK to run with no infrastructure at all: the app falls back to an
# in-memory store and every screen works. Production refuses to do this.
#
# When you do set it, use the **Transaction pooler** string (port 6543).
# Supabase → Project Settings → Database → Connection string → Transaction
# pooler. Serverless functions open a connection per instance and the direct
# port will exhaust the limit under load.
DATABASE_URL=

# The **Direct connection** or Session pooler string (port 5432), used only by
# `npm run db:deploy`. DDL cannot run through the transaction pooler.
MIGRATE_DATABASE_URL=

# Connections per warm instance. Raise only if you have measured a need.
DATABASE_POOL_MAX=3

# --- Supabase Auth ----------------------------------------------------------
#
# Anonymous sign-ins must be enabled for the entry flow to work:
# Supabase → Authentication → Sign In / Providers → Anonymous sign-ins.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional overrides. Defaults live in src/server/ai/models.ts.
AERIS_CONVERSATION_MODEL=
AERIS_CLASSIFIER_MODEL=
# Set to 1 only in tests. A production build refuses to start with it set.
AERIS_ALLOW_STUB_MODEL=

# --- Billing (Paddle, Merchant of Record) -----------------------------------
#
# Paddle is the seller of record, which is the whole reason it was chosen: VAT,
# GST and sales tax registration, collection and remittance are Paddle's
# liability rather than yours. That matters most for EU consumers, where a
# non-EU seller owes VAT from the first euro with no threshold.
#
# Commercial kill switch. With this false, no checkout opens and no webhook is
# processed — and every exercise, the delay timer and all safety paths still
# work. That is the intended failure mode.
BILLING_ENABLED=false

# sandbox | production. Must match the API key and webhook secret below: they
# are different values in each environment and are not interchangeable.
PADDLE_ENVIRONMENT=sandbox

# Paddle → Developer tools → Authentication.
PADDLE_API_KEY=
# Paddle → Developer tools → Notifications → your destination → secret key.
PADDLE_WEBHOOK_SECRET=
# Paddle → Developer tools → Authentication → Client-side tokens. Public by
# design: it can only open a checkout, never read an account.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Price ids (pri_...). Each maps to exactly one plan; anything unrecognised
# grants the free tier rather than a guess at what was meant.
PADDLE_PRICE_PLUS_MONTHLY=
PADDLE_PRICE_PLUS_ANNUAL=
PADDLE_PRICE_TEAM_SEAT_MONTHLY=
PADDLE_PRICE_PRACTITIONER_MONTHLY=

# Shown on the upgrade button. Display only — Paddle decides what is charged,
# localises it, and adds tax.
NEXT_PUBLIC_PLUS_PRICE_LABEL=US$12/month

# --- Analytics (consent-gated, event allowlist, never message text) ---------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Scheduled jobs ---------------------------------------------------------
CRON_SECRET=
