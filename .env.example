# ---------------------------------------------------------------------------
# Aeris environment. Copy to .env.local for development.
# Never put a secret in a NEXT_PUBLIC_* variable.
# ---------------------------------------------------------------------------

# Deployment identity. Server-authoritative; a production build refuses to
# start without it. One of: development | staging | production
APP_ENV=development

# --- Database (Supabase Postgres) ------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional overrides. Defaults live in src/server/ai/models.ts.
AERIS_CONVERSATION_MODEL=
AERIS_CLASSIFIER_MODEL=
# Set to 1 only in tests. A production build refuses to start with it set.
AERIS_ALLOW_STUB_MODEL=

# --- Billing (Paddle, Merchant of Record) -----------------------------------
# Commercial kill switch. Production must opt in explicitly.
BILLING_ENABLED=false
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_PLUS_MONTHLY=
PADDLE_PRICE_PLUS_ANNUAL=
PADDLE_PRICE_TEAM_SEAT_MONTHLY=

# --- Analytics (consent-gated, event allowlist, never message text) ---------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Scheduled jobs ---------------------------------------------------------
CRON_SECRET=
